# All variables are optional. Without them the site runs in "local demo mode":
# form submissions and planner data are stored only in the visitor's browser.

# POST endpoint that accepts JSON form submissions (e.g. a Formspree form URL
# such as https://formspree.io/f/xxxxxxx, or your own serverless function).
# Used by the enquiry, interest, student-discount and routine-sheet forms.
VITE_FORM_ENDPOINT=

# Plausible Analytics domain (e.g. nightnest.co.uk). When set, the Plausible
# script is loaded and CTA/form events are sent as custom events.
VITE_PLAUSIBLE_DOMAIN=

# Public contact email shown in the footer and contact page.
VITE_CONTACT_EMAIL=

# Public social profile URLs. Links are hidden until these are set.
VITE_INSTAGRAM_URL=
VITE_TIKTOK_URL=
